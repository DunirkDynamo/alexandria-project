[flake8]
max-line-length = 88
extend-ignore = E203, E501, W503
exclude =
    .git,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    .ruff_cache,
    .tox,
    .venv,
    venv,
    alexandria_env,
    build,
    dist,
    docs/_build
per-file-ignores =
    src/alexandria/__init__.py:F401
    src/alexandria/analyzers/__init__.py:F401
    src/alexandria/plotters/__init__.py:F401
    src/alexandria/utils/__init__.py:F401
    src/alexandria/wrappers/__init__.py:F401
